#domain
DOMAIN_NAME="geoguessangola"

# Volumes
VOLUMES_ROOT=/home/data/geoguess
VOLUMES_STATIC=static
VOLUMES_MEDIA=media
VOLUMES_CERTIFICATES=certificates
VOLUMES_POSTGRES =postgres
VOLUMES_BACKUPS=/home/backups


# Backup
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7

# PostgreSQL
POSTGRES_DB=geoguessangola
POSTGRES_USER=geoangola
POSTGRES_VERSION=15

# Backend
BACKEND_PORT=8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST= redis
DJANGO_WSGI_MODULE=config.wsgi

# Frontend
FRONTEND_PORT=5173

# Adminer
ADMINER_PORT=8080

# Nginx
NGINX_PORT=443

# Redis
REDIS_PORT=6379

#secrets
SECRETS_DIR=secrets

#compose_var
COMPOSE = docker compose --env-file src/.env -f src/docker-compose.yml
