#domain
DOMAIN_NAME="gueoguessangola"

# Volumes
VOLUMES_STATIC=static
VOLUMES_MEDIA=media
VOLUMES_CERTIFICATES=certificates
VOLUMES_POSTGRES =postgres
VOLUMES_ROOT=/home/data/geoguess

# PostgreSQL
POSTGRES_DB=geoguessangola
POSTGRES_USER=geoangola
POSTGRES_VERSION=15

# Backend
BACKEND_PORT=8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST= redis
DJANGO_WSGI_MODULE=config.wsgi

# Frontend
FRONTEND_PORT=5173

# Adminer
ADMINER_PORT=8080

# Nginx
NGINX_PORT=443

# Redis
REDIS_PORT=6379

#secrets
SECRETS_DIR=secrets